{
  "name": "codeflow3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/sync-wasm.ts",
    "dev": "bun scripts/dev.ts",
    "server": "bun --watch server/index.ts",
    "client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codeflow-map/core": "1.0.3",
    "@google/model-viewer": "4.0.0",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "chokidar": "^4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.7",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
